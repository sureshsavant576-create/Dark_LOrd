# LabLink Environment Configuration

# -------------------------------------------------------------
# 1. Server Configuration (Optional)
# -------------------------------------------------------------
PORT=3000

# -------------------------------------------------------------
# 2. Database (No setup or API key needed!)
# -------------------------------------------------------------
# Database uses built-in Node.js SQLite (DatabaseSync).
# SQLite file is automatically created and seeded at data/lablink.sqlite.
# No external database connection strings, passwords, or servers required.

# -------------------------------------------------------------
# 3. AI / LLM Project Matching (Optional)
# -------------------------------------------------------------
# If OPENAI_API_KEY is NOT set:
#   LabLink automatically falls back to built-in local deterministic keyword
#   and regex specification extraction with zero external network calls.
#
# Optional: use Google's Gemini OpenAI-compatible API. The same configured LLM
# supports requirement extraction and grounded assistant/aggregate insight calls.
# Keep the key server-side; never expose it in public/app.js.
# OPENAI_API_KEY=your-gemini-api-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# OPENAI_MODEL=gemini-2.5-flash
# For OpenAI instead, use its chat/completions URL and a model enabled for your key.

# -------------------------------------------------------------
# 4. Fairness Policy Tuning (Optional)
# -------------------------------------------------------------
# Override default algorithm weights by passing a JSON object:
# LABLINK_FAIRNESS_POLICY={"urgency":0.25,"deadline":0.25,"access_balance":0.20,"department_balance":0.15,"specification_fit":0.15,"repeat_penalty":0.20}
