# LabLink Environment Configuration

# -------------------------------------------------------------
# 1. Server Configuration (Optional)
# -------------------------------------------------------------
PORT=3000

# -------------------------------------------------------------
# 2. Database (current app adapter)
# -------------------------------------------------------------
# The Node API currently uses built-in Node.js SQLite (DatabaseSync),
# automatically created and seeded at data/lablink.sqlite.
# The Supabase schema and read-only public catalog API are prepared separately;
# the booking API has not yet switched to hosted PostgreSQL.
#
# Never put a service-role key in public/ or in a browser-exposed variable.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=server-only-secret

# -------------------------------------------------------------
# 3. Demo session and AI (Optional)
# Set a random 32+ character value in hosted environments to keep demo sessions
# valid across instances. Store it in a secret manager, never in source control.
LABLINK_SESSION_SECRET=
# Add a Gemini key in your hosting provider's secret settings to enable GenAI.
# Without GEMINI_API_KEY, project search uses the clearly labeled local fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional; this is the default Gemini OpenAI-compatible endpoint.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Optional OpenAI-compatible provider fallback when Gemini is not configured.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4o-mini

# 4. Fairness Policy Tuning (Optional)
# -------------------------------------------------------------
# Override default algorithm weights by passing a JSON object:
# LABLINK_FAIRNESS_POLICY={"urgency":0.25,"deadline":0.25,"access_balance":0.20,"department_balance":0.15,"specification_fit":0.15,"repeat_penalty":0.20,"history_days":30,"usage_limit":8,"no_show_grace_hours":2,"repeat_no_show_threshold":3}
